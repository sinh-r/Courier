<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The rule that keeps the solution honest (TECH_SPEC 2): Courier.Core references no UI package
    and no Windows-only API. Everything platform-specific sits behind an interface in Abstractions.
    Courier.Core.Tests/ArchitectureTests enforces this; do not add a reference that breaks it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Only for the response buffer's memory-mapped view. PERF-05. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>Courier.Core</PackageId>
    <Description>Collection model, HTTP execution, variables, auth abstractions and capsules for Courier.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="JsonPath.Net" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Courier.Core.Tests" />
    <InternalsVisibleTo Include="Courier.Perf.Tests" />
  </ItemGroup>

</Project>
