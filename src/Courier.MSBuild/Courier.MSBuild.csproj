<Project Sdk="Microsoft.NET.Sdk">

  <!--
    netstandard2.0 because MSBuild tasks load into the build host, which may be .NET Framework
    under Visual Studio. That is also why this project cannot reference Courier.Scanner (net10.0):
    CourierScanTask shells out to the `courier` tool and parses its JSON report instead.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Courier.MSBuild</PackageId>
    <Description>Build-time collection generation: keeps a Courier collection current on every build.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <Nullable>disable</Nullable>

    <!-- netstandard2.0 with C# 7.3 idioms; the modern style rules do not apply to this project. -->
    <NoWarn>$(NoWarn);IDE0161;IDE0090;IDE0063;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/Courier.MSBuild.props" Pack="true" PackagePath="build/" />
    <None Include="build/Courier.MSBuild.targets" Pack="true" PackagePath="build/" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="tasks/netstandard2.0/" Visible="false" />
  </ItemGroup>

</Project>
