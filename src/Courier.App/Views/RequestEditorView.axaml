<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Courier.App.ViewModels"
             xmlns:controls="clr-namespace:Courier.App.Controls"
             x:Class="Courier.App.Views.RequestEditorView"
             x:DataType="vm:MainWindowViewModel">

  <Border Background="{DynamicResource Paper}">
    <DockPanel LastChildFill="True">

      <!--
        Capsule banner. Shown on a tab that arrived from an imported capsule. CAP-06 requires
        stating which placeholders resolved and which did not before allowing a send.
      -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Rule}"
              BorderThickness="0,0,0,1"
              Padding="8,4"
              IsVisible="{Binding Tabs.Active.State.Capsule, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, TargetNullValue=False}">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Classes="mono" Text="{Binding Tabs.Active.State.Capsule.FileName}" />
          <TextBlock Classes="meta"
                     Text="{Binding Tabs.Active.State.Capsule.ExportedBy, StringFormat='imported from {0}'}" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="meta" Text="▲" Foreground="{DynamicResource Share}" />
            <TextBlock Classes="meta" Foreground="{DynamicResource Share}"
                       Text="{Binding Tabs.Active.State.Capsule.Resolved.Count, StringFormat='{}{0} placeholders resolved'}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4"
                      IsVisible="{Binding Tabs.Active.State.Capsule.Unresolved.Count, Converter={StaticResource IsNotZeroConverter}}">
            <TextBlock Classes="meta" Text="▲" Foreground="{DynamicResource Secret}" />
            <TextBlock Classes="meta" Foreground="{DynamicResource Secret}"
                       Text="{Binding Tabs.Active.State.Capsule.Unresolved.Count, StringFormat='{}{0} unresolved'}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!--
        Send-preparation failures: an unresolved {{variable}}, an unfilled path parameter, or a URL
        that is not absolute. UI_SPEC 3.7 — plain, active, specific, never "an error occurred".
      -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Rule}"
              BorderThickness="0,0,0,1"
              Padding="8,4"
              IsVisible="{Binding Tabs.Active.SendError, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, TargetNullValue=False}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="meta" Text="▲" Foreground="{DynamicResource Secret}" />
          <TextBlock Classes="meta" Foreground="{DynamicResource Secret}" TextWrapping="Wrap"
                     Text="{Binding Tabs.Active.SendError}" />
        </StackPanel>
      </Border>

      <!--
        Name and folder. The tab header only ever displays these — this is the one place either
        can be set, which is what lets a hand-authored request be named and filed into a folder
        before Ctrl+S saves it.
      -->
      <Border DockPanel.Dock="Top" Height="{DynamicResource RowHeight}" Padding="8,0"
              BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,8,200">
          <TextBox Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="0"
                   VerticalAlignment="Center" PlaceholderText="Untitled request"
                   Text="{Binding Tabs.Active.Title, Mode=TwoWay}"
                   AutomationProperties.Name="Request name" />
          <TextBox Grid.Column="2" Classes="mono" BorderThickness="0" Background="Transparent" Padding="0"
                   VerticalAlignment="Center" PlaceholderText="folder (optional)"
                   Text="{Binding Tabs.Active.Folder, Mode=TwoWay}"
                   AutomationProperties.Name="Request folder" />
        </Grid>
      </Border>

      <!-- URL bar. -->
      <Border DockPanel.Dock="Top" Height="32" Padding="8,0"
              BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,4,*,8,Auto" VerticalAlignment="Center">

          <ComboBox Grid.Column="0" Width="92"
                    ItemsSource="{x:Static vm:HttpMethods.All}"
                    SelectedItem="{Binding Tabs.Active.Method, Mode=TwoWay}"
                    AutomationProperties.Name="HTTP method" />

          <!--
            Variable references stay visible as {{name}} and resolve on hover, so the user can see
            what will actually be sent without the URL becoming unreadable. CORE-04.
          -->
          <TextBox Grid.Column="2" Name="UrlBox"
                   Text="{Binding Tabs.Active.Url, Mode=TwoWay}"
                   PlaceholderText="{}{{baseUrl}}/api/v2/orders/{id}"
                   AutomationProperties.Name="Request URL" />

          <!--
            Send, or Cancel with an elapsed timer while in flight. UI_SPEC 8 asks how to treat a
            request longer than ~2s; the mock answers with the elapsed time beside a Cancel, which
            reports a fact rather than decorating the wait.
          -->
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="meta mono" VerticalAlignment="Center"
                       IsVisible="{Binding Tabs.Active.IsSending}"
                       Text="{Binding Tabs.Active.Elapsed, Converter={StaticResource ElapsedConverter}}" />
            <Button Content="Cancel" Command="{Binding CancelSendCommand}"
                    IsVisible="{Binding Tabs.Active.IsSending}" />
            <Button Classes="primary" Content="Send" Width="64"
                    Command="{Binding SendCommand}"
                    IsVisible="{Binding !Tabs.Active.IsSending}"
                    AutomationProperties.Name="Send request" />
          </StackPanel>

        </Grid>
      </Border>

      <!--
        Request sections. SelectedIndex is bound (rather than a single TabItem's IsSelected) so a
        scanned request can default to whichever tab actually has something on it — see
        TabViewModel.ResolveInitialRequestTabIndex — and so the choice survives suspend/restore via
        TabState.ActiveRequestTabIndex.
      -->
      <TabControl DockPanel.Dock="Top" Padding="0" Background="Transparent"
                  SelectedIndex="{Binding Tabs.Active.ActiveRequestTabIndex, Mode=TwoWay}">

        <!--
          Route parameters. Only present when the URL actually has {tokens} — most requests have
          none, and a permanently-empty tab is worse than one that appears when it is relevant.
        -->
        <TabItem Header="Path"
                 IsVisible="{Binding Tabs.Active.PathParamEditor.Rows.Count, Converter={StaticResource IsNotZeroConverter}}">
          <controls:PathParamGrid ItemsSource="{Binding Tabs.Active.PathParamEditor.Rows}" />
        </TabItem>

        <!-- Header reads "Params · 3" once there is a row to look at, so a populated tab is
             visible without clicking into it — the params a scan derived used to be invisible
             here, hidden behind the Body tab that opened by default. -->
        <TabItem Header="{Binding Tabs.Active.ParamsTabHeader}">
          <controls:KeyValueGrid ItemsSource="{Binding Tabs.Active.QueryEditor.Rows}" />
        </TabItem>

        <TabItem Header="{Binding Tabs.Active.HeadersTabHeader}">
          <DockPanel LastChildFill="True">
            <!--
              Inherited headers: app defaults, then the collection's own — muted, with where each
              came from, and only shown when the request has not already overridden that name. P4:
              nothing reaches the wire that is not on screen.
            -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding InheritedHeadersForActiveTab}"
                          IsVisible="{Binding InheritedHeadersForActiveTab.Count, Converter={StaticResource IsNotZeroConverter}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InheritedHeaderRow">
                  <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="8,0">
                    <Grid ColumnDefinitions="24,220,*,180" Height="{DynamicResource RowHeight}">
                      <TextBlock Grid.Column="1" Classes="mono meta" Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="mono meta" Text="{Binding Value}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Origin}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <controls:KeyValueGrid ItemsSource="{Binding Tabs.Active.HeaderEditor.Rows}" />
          </DockPanel>
        </TabItem>

        <TabItem Header="Body">
          <controls:BodyEditor />
        </TabItem>

        <TabItem Header="Auth">
          <controls:RequestAuthPanel DataContext="{Binding}" />
        </TabItem>

        <TabItem Header="Scripts">
          <controls:ScriptEditor />
        </TabItem>

      </TabControl>

    </DockPanel>
  </Border>

</UserControl>
