<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Courier.App.ViewModels"
             xmlns:controls="clr-namespace:Courier.App.Controls"
             xmlns:storage="clr-namespace:Courier.Core.Storage;assembly=Courier.Core"
             xmlns:abs="clr-namespace:Courier.Core.Abstractions;assembly=Courier.Core"
             x:Class="Courier.App.Views.Dialogs.SettingsView"
             x:DataType="vm:MainWindowViewModel">

  <!--
    One settings shell with a left nav, as the mock has it: Environments, Auth profiles, Trust and
    network, Storage, Keyboard.
  -->

  <Border Classes="floating" Width="960" Height="620"
          HorizontalAlignment="Center" VerticalAlignment="Center">

    <DockPanel LastChildFill="True">

      <Border DockPanel.Dock="Top" Height="40" Padding="16,0"
              BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="title" VerticalAlignment="Center" Text="Settings" />
          <Button Grid.Column="1" Classes="bare" Content="×" Command="{Binding CloseDialogCommand}"
                  AutomationProperties.Name="Close settings" />
        </Grid>
      </Border>

      <!-- Left nav. -->
      <Border DockPanel.Dock="Left" Width="180" Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,8">
          <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Height="{DynamicResource RowHeight}" Padding="16,0" Content="Environments"
                  Command="{Binding OpenDialogCommand}" CommandParameter="{x:Static vm:DialogKind.Environments}" />
          <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Height="{DynamicResource RowHeight}" Padding="16,0" Content="Global variables"
                  Command="{Binding OpenDialogCommand}" CommandParameter="{x:Static vm:DialogKind.GlobalVariables}" />
          <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Height="{DynamicResource RowHeight}" Padding="16,0" Content="Auth profiles"
                  Command="{Binding OpenDialogCommand}" CommandParameter="{x:Static vm:DialogKind.AuthProfile}" />
          <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Height="{DynamicResource RowHeight}" Padding="16,0" Content="Trust and network"
                  Command="{Binding OpenDialogCommand}" CommandParameter="{x:Static vm:DialogKind.TrustAndNetwork}" />
          <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Height="{DynamicResource RowHeight}" Padding="16,0" Content="Storage"
                  Command="{Binding OpenDialogCommand}" CommandParameter="{x:Static vm:DialogKind.Storage}" />
          <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Height="{DynamicResource RowHeight}" Padding="16,0" Content="Keyboard"
                  Command="{Binding OpenDialogCommand}" CommandParameter="{x:Static vm:DialogKind.Keyboard}" />
          <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Height="{DynamicResource RowHeight}" Padding="16,0" Content="Appearance"
                  Command="{Binding OpenDialogCommand}" CommandParameter="{x:Static vm:DialogKind.Appearance}" />
          <Button Classes="bare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Height="{DynamicResource RowHeight}" Padding="16,0" Content="Default headers"
                  Command="{Binding OpenDialogCommand}" CommandParameter="{x:Static vm:DialogKind.DefaultHeaders}" />
        </StackPanel>
      </Border>

      <Panel>

        <!--
          Environments of the current collection. SEC-03, CORE-12, UI_SPEC 5.5: two columns per
          variable, shared (goes in git) and local (this machine only, in the OS credential store).
        -->
        <ScrollViewer Padding="16"
                      IsVisible="{Binding Dialog, Converter={StaticResource DialogIsConverter}, ConverterParameter=Environments}">
          <controls:EnvironmentEditor DataContext="{Binding Environments}" />
        </ScrollViewer>

        <!-- Global variables: the same table, for the one set every collection falls back to. -->
        <ScrollViewer Padding="16"
                      IsVisible="{Binding Dialog, Converter={StaticResource DialogIsConverter}, ConverterParameter=GlobalVariables}">
          <controls:EnvironmentEditor DataContext="{Binding GlobalVariables}" />
        </ScrollViewer>

        <!--
          Auth profiles. ENT-02, ENT-06: named presets saved to the open collection's auth/ folder
          and shared through git — never the secret, only a pointer into each person's own
          credential store. A profile picked here can be set as the collection's default, which is
          what a request left on "Inherit from collection" actually uses.
        -->
        <Grid ColumnDefinitions="200,*"
              IsVisible="{Binding Dialog, Converter={StaticResource DialogIsConverter}, ConverterParameter=AuthProfile}">

          <!-- The list. New/Delete act on whatever is selected, or on NewProfileName for a create. -->
          <DockPanel Grid.Column="0" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Bottom" Margin="16,8" Spacing="6">
              <TextBox Classes="mono" PlaceholderText="new profile name"
                        Text="{Binding AuthProfileEditor.NewProfileName}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="New" Command="{Binding AuthProfileEditor.StartNewProfileCommand}" />
                <Button Content="Delete" IsEnabled="{Binding AuthProfileEditor.SelectedProfileName, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Command="{Binding AuthProfileEditor.DeleteCommand}" />
              </StackPanel>
            </StackPanel>

            <ListBox ItemsSource="{Binding AuthProfileEditor.ProfileNames}"
                     SelectedItem="{Binding AuthProfileEditor.SelectedProfileName, Mode=TwoWay}" />
          </DockPanel>

          <ScrollViewer Grid.Column="1" Padding="16"
                        BorderBrush="{DynamicResource Rule}" BorderThickness="1,0,0,0">
            <StackPanel Spacing="14">

              <TextBlock Classes="heading" Text="{Binding AuthProfileEditor.SelectedProfileName, FallbackValue='New profile', TargetNullValue='New profile'}" />
              <TextBlock Classes="meta" Text="{Binding AuthProfileEditor.StatusMessage}"
                         IsVisible="{Binding AuthProfileEditor.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <Grid ColumnDefinitions="90,*">
                <TextBlock Grid.Column="0" Classes="meta" Text="Kind" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:AuthKindOptions.Labels}"
                          SelectedItem="{Binding AuthProfileEditor.KindLabel, Mode=TwoWay}" />
              </Grid>

              <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="14"
                      IsVisible="{Binding AuthProfileEditor.ShowsEntraFields}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="90,*">
                    <TextBlock Grid.Column="0" Classes="meta" Text="Tenant" />
                    <TextBox Grid.Column="1" Classes="mono" PlaceholderText="contoso.onmicrosoft.com"
                             Text="{Binding AuthProfileEditor.Tenant}" />
                  </Grid>
                  <Grid ColumnDefinitions="90,*">
                    <TextBlock Grid.Column="0" Classes="meta" Text="Client" />
                    <TextBox Grid.Column="1" Classes="mono" Text="{Binding AuthProfileEditor.ClientId}" />
                  </Grid>
                  <Grid ColumnDefinitions="90,*">
                    <TextBlock Grid.Column="0" Classes="meta" Text="Scope" />
                    <TextBox Grid.Column="1" Classes="mono" PlaceholderText="api://orders/.default"
                             Text="{Binding AuthProfileEditor.ScopesText}" />
                  </Grid>
                  <Grid ColumnDefinitions="90,*" IsVisible="{Binding AuthProfileEditor.ShowsRedirectUri}">
                    <TextBlock Grid.Column="0" Classes="meta" Text="Redirect URI" />
                    <TextBox Grid.Column="1" Classes="mono" PlaceholderText="http://localhost"
                             Text="{Binding AuthProfileEditor.RedirectUri}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="90,*" IsVisible="{Binding AuthProfileEditor.ShowsUsername}">
                <TextBlock Grid.Column="0" Classes="meta" Text="Username" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Classes="mono" Text="{Binding AuthProfileEditor.Username}" />
              </Grid>

              <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="14"
                      IsVisible="{Binding AuthProfileEditor.ShowsSecretField}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="heading" Text="{Binding AuthProfileEditor.SecretFieldLabel}" />
                  <TextBlock Classes="meta" TextWrapping="Wrap"
                             Text="Goes to the OS credential store, never to a file in the collection." />
                  <TextBox Classes="mono" PasswordChar="•" PlaceholderText="new value"
                           Text="{Binding AuthProfileEditor.SecretInput}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▲" Foreground="{DynamicResource Secret}"
                               IsVisible="{Binding !AuthProfileEditor.HasStoredSecret}" />
                    <TextBlock Classes="meta" Foreground="{DynamicResource Secret}"
                               Text="{Binding AuthProfileEditor.SecretStatusText}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Save" Command="{Binding AuthProfileEditor.SaveCommand}" />
                <Button Content="Get token" IsVisible="{Binding AuthProfileEditor.CanGetToken}"
                        Command="{Binding AuthProfileEditor.GetTokenCommand}" />
                <Button Content="Set as collection default"
                        IsEnabled="{Binding !AuthProfileEditor.IsCollectionDefault}"
                        Command="{Binding AuthProfileEditor.SetAsCollectionDefaultCommand}"
                        CommandParameter="{Binding Tree}" />
                <TextBlock Classes="meta" VerticalAlignment="Center" Text="✓ collection default"
                           IsVisible="{Binding AuthProfileEditor.IsCollectionDefault}" />
              </StackPanel>

              <!-- The decoded token panel. ENT-04: a plain table, and never a validity verdict. -->
              <StackPanel Spacing="6" IsVisible="{Binding AuthProfileEditor.CanGetToken}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="heading" Text="Decoded token" />
                  <TextBlock Grid.Column="1" Classes="meta" Text="{Binding AuthProfileEditor.TokenTimingLine}" />
                </Grid>

                <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1">
                  <ItemsControl ItemsSource="{Binding AuthProfileEditor.Claims}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TokenClaimViewModel">
                        <Border Height="{DynamicResource RowHeight}" Padding="8,0"
                                BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="90,*,Auto">
                            <TextBlock Grid.Column="0" Classes="mono meta" VerticalAlignment="Center"
                                       Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" Classes="mono" VerticalAlignment="Center"
                                       Text="{Binding Value}" />
                            <TextBlock Grid.Column="2" Classes="meta" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Secret}"
                                       Text="{Binding Warning}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>

                <TextBlock Classes="meta" TextWrapping="Wrap"
                           Text="Decoded, not validated. Courier is not the resource server and does not have the signing keys, so it reports what the token says about itself and nothing more." />
              </StackPanel>

              <!--
                Collection default. What a request left on "Inherit from collection" actually uses —
                the same Inherit/None/fixed-kind/saved-profile choice a request's own Auth tab offers,
                but for the collection itself, typed here rather than requiring a profile be saved
                first. ENT-02, ENT-06.
              -->
              <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,4,0,0">
                <StackPanel Spacing="14">
                  <TextBlock Classes="heading" Text="Collection default" />
                  <TextBlock Classes="meta" TextWrapping="Wrap"
                             Text="Used by any request in this collection left on &quot;Inherit from collection&quot;." />

                  <Grid ColumnDefinitions="90,*">
                    <TextBlock Grid.Column="0" Classes="meta" Text="Auth" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding CollectionAuth.Options}"
                              SelectedItem="{Binding CollectionAuth.SelectedOption, Mode=TwoWay}"
                              AutomationProperties.Name="Collection default auth" />
                  </Grid>

                  <StackPanel Spacing="8" IsVisible="{Binding CollectionAuth.IsInline}">

                    <Grid ColumnDefinitions="90,*" IsVisible="{Binding CollectionAuth.ShowsEntraFields}">
                      <TextBlock Grid.Column="0" Classes="meta" Text="Tenant" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="mono" PlaceholderText="contoso.onmicrosoft.com"
                                Text="{Binding CollectionAuth.Tenant}" />
                    </Grid>

                    <Grid ColumnDefinitions="90,*" IsVisible="{Binding CollectionAuth.ShowsEntraFields}">
                      <TextBlock Grid.Column="0" Classes="meta" Text="Client ID" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="mono" Text="{Binding CollectionAuth.ClientId}" />
                    </Grid>

                    <Grid ColumnDefinitions="90,*" IsVisible="{Binding CollectionAuth.ShowsEntraFields}">
                      <TextBlock Grid.Column="0" Classes="meta" Text="Scope" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="mono" PlaceholderText="api://orders/.default"
                                Text="{Binding CollectionAuth.ScopesText}" />
                    </Grid>

                    <Grid ColumnDefinitions="90,*" IsVisible="{Binding CollectionAuth.ShowsRedirectUri}">
                      <TextBlock Grid.Column="0" Classes="meta" Text="Redirect URI" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="mono" PlaceholderText="http://localhost"
                                Text="{Binding CollectionAuth.RedirectUri}" />
                    </Grid>

                    <Grid ColumnDefinitions="90,*" IsVisible="{Binding CollectionAuth.ShowsUsername}">
                      <TextBlock Grid.Column="0" Classes="meta" Text="Username" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="mono" Text="{Binding CollectionAuth.Username}" />
                    </Grid>

                    <Grid ColumnDefinitions="90,*,Auto" IsVisible="{Binding CollectionAuth.ShowsSecretField}">
                      <TextBlock Grid.Column="0" Classes="meta" VerticalAlignment="Center"
                                 Text="{Binding CollectionAuth.SecretFieldLabel}" />
                      <TextBox Grid.Column="1" Classes="mono" PasswordChar="•" PlaceholderText="new value"
                                Text="{Binding CollectionAuth.SecretInput}" />
                      <TextBlock Grid.Column="2" Classes="meta" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding CollectionAuth.SecretStatusText}" />
                    </Grid>

                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Save" Command="{Binding SaveCollectionAuthCommand}" />
                    <Button Content="Get token" IsVisible="{Binding CollectionAuth.CanGetToken}"
                            Command="{Binding CollectionAuth.GetTokenCommand}" />
                  </StackPanel>

                  <TextBlock Classes="meta" Text="{Binding CollectionAuthStatus}"
                             IsVisible="{Binding CollectionAuthStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <StackPanel Spacing="6" IsVisible="{Binding CollectionAuth.CanGetToken}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="heading" Text="Decoded token" />
                      <TextBlock Grid.Column="1" Classes="meta" Text="{Binding CollectionAuth.TokenTimingLine}" />
                    </Grid>
                    <TextBlock Classes="meta" Text="{Binding CollectionAuth.TokenStatusMessage}"
                               IsVisible="{Binding CollectionAuth.TokenStatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1">
                      <ItemsControl ItemsSource="{Binding CollectionAuth.Claims}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TokenClaimViewModel">
                            <Border Height="{DynamicResource RowHeight}" Padding="8,0"
                                    BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
                              <Grid ColumnDefinitions="90,*,Auto">
                                <TextBlock Grid.Column="0" Classes="mono meta" VerticalAlignment="Center"
                                           Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" Classes="mono" VerticalAlignment="Center"
                                           Text="{Binding Value}" />
                                <TextBlock Grid.Column="2" Classes="meta" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Secret}"
                                           Text="{Binding Warning}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>

                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!--
          Trust and network. UI_SPEC 5.7: every row states its source — from Windows certificate
          store, from system proxy, set by you.
        -->
        <ScrollViewer Padding="16"
                      IsVisible="{Binding Dialog, Converter={StaticResource DialogIsConverter}, ConverterParameter=TrustAndNetwork}">
          <StackPanel Spacing="16">

            <StackPanel Spacing="6">
              <TextBlock Classes="heading" Text="Client certificate" />
              <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1">
                <StackPanel>
                  <Border Height="{DynamicResource RowHeight}" Padding="8,0"
                          BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="220,120,110,150,*">
                      <TextBlock Grid.Column="0" Classes="meta" Text="Subject" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="meta" Text="Thumbprint" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="meta" Text="Expires" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Classes="meta" Text="Host pattern" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Classes="meta" Text="Source" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Trust.Certificates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="abs:CertificateCandidate">
                        <Border Height="{DynamicResource RowHeight}" Padding="8,0"
                                BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="220,120,110,150,*">
                            <TextBlock Grid.Column="0" Classes="mono" VerticalAlignment="Center"
                                       Text="{Binding Subject}" />
                            <TextBlock Grid.Column="1" Classes="mono meta" VerticalAlignment="Center"
                                       Text="{Binding Thumbprint}" />
                            <TextBlock Grid.Column="2" Classes="mono meta" VerticalAlignment="Center"
                                       Text="{Binding NotAfter, StringFormat='{}{0:yyyy-MM-dd}'}" />
                            <TextBlock Grid.Column="3" Classes="mono meta" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Classes="meta" VerticalAlignment="Center"
                                       Text="{Binding Source}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="heading" Text="Proxy" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Trust.ProxyUri}" />
                <TextBlock Grid.Column="1" Classes="meta" Text="{Binding Trust.ProxySource}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="mono meta" Text="{Binding Trust.BypassLine}" />
                <TextBlock Grid.Column="1" Classes="meta" Text="set by you" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="heading" Text="Per-host trust" />
              <ItemsControl ItemsSource="{Binding Trust.Exceptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="abs:HostTrustException">
                    <Grid ColumnDefinitions="220,*,Auto" Height="{DynamicResource RowHeight}">
                      <TextBlock Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="{Binding Host}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="▲" Foreground="{DynamicResource Secret}" />
                        <TextBlock Classes="meta" Text="allowed for this host only" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="meta" VerticalAlignment="Center"
                                 Text="{Binding RecordedUtc, StringFormat='set by you · {0:yyyy-MM-dd}'}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!--
              A TLS failure, stated the way UI_SPEC 3.7 requires: what happened and what to do.
              There is no global "disable verification" here and there never will be — ENT-11 gives
              a per-host exception and nothing wider.
            -->
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Error}"
                    BorderThickness="2,0,0,0" Padding="12,8"
                    IsVisible="{Binding Trust.HasFailure}">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="mono" Text="⊘" Foreground="{DynamicResource Error}" />
                  <TextBlock TextWrapping="Wrap" Text="{Binding Trust.FailureHeadline}" />
                </StackPanel>
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Trust.FailureRemedy}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Allow for this host" Name="AllowHostButton" />
                  <Button Content="Show certificate chain" Name="ShowChainButton" />
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!--
          Storage. SEC-05: every location where data is stored on disk, with a one-click reveal and
          a destructive clear per category.
        -->
        <ScrollViewer Padding="16"
                      IsVisible="{Binding Dialog, Converter={StaticResource DialogIsConverter}, ConverterParameter=Storage}">
          <StackPanel Spacing="12">

            <TextBlock Classes="heading" Text="Where Courier stores data on this machine" />

            <ItemsControl ItemsSource="{Binding StorageLocationsList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="storage:StorageLocation">
                  <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="heading" Text="{Binding Category}" />
                        <TextBlock Classes="mono meta" Text="{Binding Path}" />
                        <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Contents}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="Reveal" Height="20" />
                        <Button Content="Clear" Height="20" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- SEC-06. Generated from what the process actually did, not written by hand. -->
            <StackPanel Spacing="6" Margin="0,8,0,0">
              <TextBlock Classes="heading" Text="Network behaviour statement" />
              <TextBlock Classes="meta" TextWrapping="Wrap"
                         Text="An auditable statement of every destination this build can contact and every one it has contacted this session, for security review sign-off." />
              <Button Content="Export statement" HorizontalAlignment="Left" Name="ExportStatementButton" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- Keyboard. NFR-04: full keyboard operability, and the list that proves it. -->
        <ScrollViewer Padding="16"
                      IsVisible="{Binding Dialog, Converter={StaticResource DialogIsConverter}, ConverterParameter=Keyboard}">
          <StackPanel Spacing="8">
            <TextBlock Classes="heading" Text="Keyboard" />
            <ItemsControl ItemsSource="{Binding KeyBindings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyBindingViewModel">
                  <Grid ColumnDefinitions="160,*" Height="{DynamicResource RowHeight}">
                    <TextBlock Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="{Binding Gesture}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Description}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Appearance. Light, Dark or System — the dark palette has been a full mirror all along. -->
        <ScrollViewer Padding="16"
                      IsVisible="{Binding Dialog, Converter={StaticResource DialogIsConverter}, ConverterParameter=Appearance}">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Appearance" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Light" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
              <Button Content="Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
              <Button Content="Match system" Command="{Binding SetThemeCommand}" CommandParameter="System" />
            </StackPanel>
            <TextBlock Classes="meta" Text="{Binding ThemeName, StringFormat='Current: {0}'}" />
          </StackPanel>
        </ScrollViewer>

        <!--
          Default headers. Accept and User-Agent by default — Courier sent neither before this
          existed, and some WAF-fronted corporate APIs challenge a request with no User-Agent at
          all. Applied under the collection's own headers and the request's own, which each win.
        -->
        <ScrollViewer Padding="16"
                      IsVisible="{Binding Dialog, Converter={StaticResource DialogIsConverter}, ConverterParameter=DefaultHeaders}">
          <StackPanel Spacing="12">
            <TextBlock Classes="heading" Text="Default headers" />
            <TextBlock Classes="meta" TextWrapping="Wrap"
                       Text="Applied to every request, under the collection's own headers and the request's own — each of those wins over this by name." />
            <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1" Height="200">
              <controls:KeyValueGrid ItemsSource="{Binding DefaultHeadersEditor.Rows}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

      </Panel>

    </DockPanel>
  </Border>

</UserControl>
