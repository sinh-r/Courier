<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Courier.App.ViewModels"
             x:Class="Courier.App.Views.Dialogs.ConfirmCloseTabView"
             x:DataType="vm:MainWindowViewModel">

  <!--
    Reached only by the user's own close action on a dirty tab (the × button, middle-click, Ctrl+W,
    or the palette's "Close tab") — never shown unprompted, which is what keeps this consistent
    with DialogHost's rule that every modal here is an explicit action, not an interruption.
  -->

  <Border Classes="floating" Width="420" Padding="24"
          HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="14">

      <TextBlock Classes="title"
                 Text="{Binding PendingCloseTab.Title, StringFormat='Save changes to {0}?'}" />

      <TextBlock Classes="meta" TextWrapping="Wrap"
                 Text="Closing this tab without saving discards the edits. This cannot be undone." />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Command="{Binding CloseDialogCommand}" />
        <Button Content="Don't save" Command="{Binding ConfirmCloseTabDiscardCommand}" />
        <Button Classes="primary" Content="Save and close" Command="{Binding ConfirmCloseTabSaveCommand}" />
      </StackPanel>

    </StackPanel>
  </Border>

</UserControl>
