<Project>

  <!-- Solution-wide build settings. TECH_SPEC.md 1.1. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Reproducible builds so a security reviewer can verify the binary against source. NFR-08. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Lets a non-Windows machine restore a project that multi-targets a Windows TFM.

      Courier.App targets net10.0 and net10.0-windows10.0.19041.0, and restore resolves every TFM
      even when only one is being built - so on Linux, `dotnet build -f net10.0` still fails with
      NETSDK1100 ("Windows is required to build ...") without this. TECH_SPEC 1.3 keeps macOS and
      Linux building so contributors without Windows can work on the scanner and the CLI, and that
      promise is worth nothing if the obvious command fails on a flag they have to know about.

      A no-op on Windows.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Courier</Product>
    <Company>Courier</Company>
    <Authors>Courier contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright the Courier contributors</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Transitive pinning is deliberately off. It turns every transitive dependency into a real
      PackageReference, which breaks MSBuildLocator: the locator requires the MSBuild assemblies to
      be compile-time only so it can bind the installed SDK's copies at runtime, and a pinned
      transitive reference reintroduces them as runtime assets (MSBL001). Direct versions are still
      pinned in Directory.Packages.props, which is what the "do not float versions" rule asks for.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

</Project>
